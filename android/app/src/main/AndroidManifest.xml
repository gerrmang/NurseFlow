<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets the Kakao SDK detect KakaoTalk for one-tap login on Android 11+. -->
    <queries>
        <package android:name="com.kakao.talk" />
    </queries>

    <application
        android:name=".NurseFlowApplication"
        android:allowBackup="false"
        android:label="NurseFlow"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Invitation link: nurseflow://invite#token=… (server NURSEFLOW_INVITE_LINK_BASE=nurseflow://invite).
                 Switch to a verified https App Link once a production domain exists. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="invite"
                    android:scheme="nurseflow" />
            </intent-filter>
        </activity>

        <!-- Kakao account login returns here (scheme kakao{NATIVE_APP_KEY}://oauth). -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="oauth"
                    android:scheme="${kakaoScheme}" />
            </intent-filter>
        </activity>
    </application>
</manifest>
